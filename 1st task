#include <iostream>
using namespace std;

int n;
bool is_even(int n) {
        if (n % 2 == 0){
            return true;
        }
        else {
            return false;
        }
    }
int main() {
    int n;
    
    cin >> n;
    if (is_even(n) == true){
        while (n != 0){
            if (n == 1){
                cout << "b";
                return 0;
            }
            else {
                cout << "a";    
            }
            n--;
        }
    }
    else {
        while (n != 0){
            cout << "a";
            n--;
        }
    }
    
    return 0;
}
