#include <iostream>
using namespace std;

int main() {

    int n;
    cin >> n;

    int c = 0;
    int max = 0;
    int i = 0;

    while (i < n){
        int x;
        cin >> x;

        if (x == 0){
            c = 0;
        }
        else {
            c++;

            if (c > max){
                max = c;
            }
        }
        i++;
        
        
    }
    cout << max;

    return 0;
}
