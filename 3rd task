#include <iostream>
using namespace std;

int main() {

    int n;
    cin >> n;

    int c = 0;
    int max = 0;
    int i = 0;

    while (i < n){
        int x;
        cin >> x;
        i++;
        
        if (x == 0){
            c = 0;
            continue;
        }
        
        c++;

        if (c > max){
            max = c;
        }
        
        
        
    }
    cout << max;

    return 0;
}
